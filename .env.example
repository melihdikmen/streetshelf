# Copy to .env.local (local stack) and .env.production (hosted). Never a bare .env.
# Local values come from `npx supabase status`: use your Mac's LAN IP instead of
# 127.0.0.1 so the simulator, the emulator and a real phone all reach it.
# The publishable (anon) key is public by design; RLS protects the data.
# Never put the service-role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54521
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Google Maps for the Android map view. Maps SDK for Android, restricted to
# com.melihdikmen.streetshelf and the signing SHA-1. Without it the map button
# is hidden on Android. Not EXPO_PUBLIC_: it goes into the manifest, not the JS.
GOOGLE_MAPS_ANDROID_API_KEY=
